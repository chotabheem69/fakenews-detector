# ==============================================================
# VeritasAI - Fake News Detector Environment Configuration
# ==============================================================

# 1. LLM Provider Configuration
# Choose your preferred provider: 'freellmapi', 'gemini', or 'openai_compatible'
LLM_PROVIDER=freellmapi

# Your API Key (from FreeLLMAPI, Google AI Studio, OpenRouter, or Groq)
LLM_API_KEY=your_api_key_here

# Base URL (for FreeLLMAPI or OpenAI-compatible endpoints)
# Defaults:
# - FreeLLMAPI: https://api.freellmapi.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Local Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.freellmapi.com/v1

# Model Name
# Examples: llama-3.1-70b, mistral-7b-instruct, gpt-3.5-turbo, gemini-2.5-flash
LLM_MODEL=llama-3.1-70b

# (Optional Backward Compatibility for Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# 3. Local Model Configuration
BERT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
USE_FALLBACK_CLASSIFIER=True
